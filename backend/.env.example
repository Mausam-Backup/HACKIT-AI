# ==========================================
# Presenton Environment Variables (Example)
# ==========================================

# 1. LLM Configuration
# --------------------
# Set the LLM provider to google, openai, anthropic, ollama, etc.
LLM=groq
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=models/gemini-2.0-flash

# 2. Image Provider Configuration
# -------------------------------
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=your_pexels_api_key_here

# 3. Application Settings
# -----------------------
# Allow changing API keys from the UI (true or false)
CAN_CHANGE_KEYS=true
# Disable anonymous telemetry tracking
DISABLE_ANONYMOUS_TRACKING=true
# Disable image generation entirely if you don't want slides with images
DISABLE_IMAGE_GENERATION=false

# 4. Authentication (Optional - for Web Login)
# --------------------------------------------
# Set these if you want to pre-seed an admin account on first boot
# AUTH_USERNAME=admin
# AUTH_PASSWORD=changeme123
#
# Disable the authentication system completely (true or false)
# DISABLE_AUTH=false
#
# Specify a custom path for the user configuration file
# USER_CONFIG_PATH=/path/to/user-config.json

# 5. Web Search Configuration
# ---------------------------
# Set the web search provider
WEB_SEARCH_PROVIDER=exa
EXA_API_KEY=your_exa_api_key_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
