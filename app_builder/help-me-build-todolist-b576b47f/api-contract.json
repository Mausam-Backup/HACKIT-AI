{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Todo List API Contract",
  "description": "REST API for the Todo List app. Both frontend and backend MUST adhere to this contract.",
  "base_url": "/api",
  "endpoints": {
    "GET /api/todos": {
      "description": "List all todos. Optionally filter by completion status.",
      "query_parameters": {
        "completed": {
          "type": "string",
          "enum": ["true", "false"],
          "required": false,
          "description": "Filter by completion status. Omit to return all."
        }
      },
      "responses": {
        "200": {
          "description": "Array of todo objects, sorted by created_at DESC",
          "content_type": "application/json",
          "schema": {
            "type": "array",
            "items": { "$ref": "#/definitions/Todo" }
          },
          "example": [
            {
              "id": 1,
              "title": "Buy groceries",
              "completed": 0,
              "created_at": "2026-07-30 12:00:00"
            },
            {
              "id": 2,
              "title": "Finish hackathon project",
              "completed": 1,
              "created_at": "2026-07-29 10:30:00"
            }
          ]
        }
      }
    },

    "POST /api/todos": {
      "description": "Create a new todo.",
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The todo task text"
            }
          }
        },
        "example": { "title": "Buy milk" }
      },
      "responses": {
        "201": {
          "description": "The newly created todo object",
          "schema": { "$ref": "#/definitions/Todo" },
          "example": {
            "id": 3,
            "title": "Buy milk",
            "completed": 0,
            "created_at": "2026-07-30 13:00:00"
          }
        },
        "400": {
          "description": "Validation error",
          "schema": { "$ref": "#/definitions/ErrorResponse" },
          "example": { "error": "Title is required" }
        }
      }
    },

    "PATCH /api/todos/:id": {
      "description": "Partially update a todo. Supports toggling completion and/or updating title.",
      "path_parameters": {
        "id": {
          "type": "integer",
          "description": "The todo ID"
        }
      },
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "completed": {
              "type": "integer",
              "enum": [0, 1],
              "description": "0 = not completed, 1 = completed"
            }
          }
        },
        "example": { "completed": 1 }
      },
      "responses": {
        "200": {
          "description": "The updated todo object",
          "schema": { "$ref": "#/definitions/Todo" },
          "example": {
            "id": 1,
            "title": "Buy groceries",
            "completed": 1,
            "created_at": "2026-07-30 12:00:00"
          }
        },
        "400": {
          "description": "Validation error",
          "schema": { "$ref": "#/definitions/ErrorResponse" }
        },
        "404": {
          "description": "Todo not found",
          "schema": { "$ref": "#/definitions/ErrorResponse" },
          "example": { "error": "Todo not found" }
        }
      }
    },

    "DELETE /api/todos/:id": {
      "description": "Delete a todo permanently.",
      "path_parameters": {
        "id": {
          "type": "integer",
          "description": "The todo ID"
        }
      },
      "responses": {
        "204": {
          "description": "Successfully deleted, no content"
        },
        "404": {
          "description": "Todo not found",
          "schema": { "$ref": "#/definitions/ErrorResponse" },
          "example": { "error": "Todo not found" }
        }
      }
    }
  },

  "definitions": {
    "Todo": {
      "type": "object",
      "required": ["id", "title", "completed", "created_at"],
      "properties": {
        "id":          { "type": "integer" },
        "title":       { "type": "string" },
        "completed":   { "type": "integer", "enum": [0, 1] },
        "created_at":  { "type": "string", "description": "ISO-8601 or SQLite datetime format" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" }
      }
    }
  }
}
