{
  "name": "hackit-ai",
  "version": "0.3.2",
  "description": "HACKIT — Autonomous AI App Builder & Hackathon Coach CLI",
  "main": "bin/cli.mjs",
  "bin": {
    "hackit": "./bin/cli.mjs",
    "hackit-ai": "./bin/cli.mjs",
    "app-builder-lite": "./bin/cli.mjs",
    "hackathon-coach": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "agents/",
    "prompts/",
    "*.py",
    "config.yaml",
    "requirements-runtime.txt",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild bin/cli.jsx --bundle --platform=node --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=bin/cli.mjs",
    "postinstall": "node bin/postinstall.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "ink": "^4.4.1",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  },
  "keywords": [
    "hackit",
    "hackit",
    "hackathon",
    "coach",
    "cli",
    "tui",
    "gui",
    "agentic",
    "app-builder",
    "scaffold",
    "react",
    "express"
  ],
  "author": "Google DeepMind Advanced Agentic Coding Team",
  "license": "MIT"
}
